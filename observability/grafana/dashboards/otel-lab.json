{
  "uid": "otel-lab-main",
  "title": "OTel Lab — Pipeline de Observabilidad End-to-End",
  "description": "SLIs de los microservicios, overhead de recursos y salud del OTel Collector. Todas las queries filtran source=\"collector\" porque las métricas llegan por dos caminos (scraping directo y vía Collector) y sin el filtro se contarían dos veces.",
  "tags": [
    "opentelemetry",
    "sli",
    "observabilidad"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total{source=\"collector\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLIs — Indicadores de Nivel de Servicio",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "SLI-1 · Disponibilidad",
      "description": "Porcentaje de peticiones que NO terminan en error del servidor. Los 4xx se cuentan como disponibles: un 404 es una respuesta correcta a una petición inválida, no una caída del servicio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(rate(http_requests_total{source=\"collector\", service=~\"$servicio\", status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{source=\"collector\", service=~\"$servicio\"}[5m])), 0.0001))",
          "legendFormat": "Disponibilidad"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SLI-2 · Latencia p50 / p95 / p99",
      "description": "Percentiles calculados sobre el histograma de OTel. El p99 es el valor que se compara en el análisis de overhead: refleja la cola lenta, donde el costo de la instrumentación se nota más que en la media.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{source=\"collector\", service=~\"$servicio\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{source=\"collector\", service=~\"$servicio\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{source=\"collector\", service=~\"$servicio\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI-3 · Tasa de error (5xx)",
      "description": "Proporción de peticiones que terminan en error del servidor. Es el complemento directo del SLI de disponibilidad y la señal que dispara una alerta de guardia.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{source=\"collector\", service=~\"$servicio\", status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{source=\"collector\", service=~\"$servicio\"}[5m])), 0.0001)",
          "legendFormat": "Error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLI-4 · Throughput (peticiones por segundo)",
      "description": "Tasa de peticiones desglosada por servicio y endpoint. Durante el benchmark debe mantenerse estable: una caída del throughput con la misma carga indica saturación.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, endpoint) (rate(http_requests_total{source=\"collector\", service=~\"$servicio\"}[1m]))",
          "legendFormat": "{{service}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia de base de datos por operación",
      "description": "p95 de las queries a PostgreSQL. Permite distinguir si una latencia alta del endpoint viene de la base de datos o del salto HTTP entre servicios.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service, table) (rate(db_query_duration_seconds_bucket{source=\"collector\"}[5m])))",
          "legendFormat": "p95 {{service}} · {{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Overhead de recursos — CPU y memoria por contenedor",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU por contenedor — instrumentado vs. línea base",
      "description": "Medido por el receiver docker_stats del Collector, desde fuera del proceso. Los contenedores *-baseline corren el MISMO código con OTEL_ENABLED=false: la diferencia entre ambas series es el costo de CPU de la instrumentación.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_name) (container_cpu_utilization_ratio{container_name=~\"service-.*|otel-collector\"})",
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*baseline.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "otel-collector"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memoria por contenedor — instrumentado vs. línea base",
      "description": "Memoria residente. El SDK de OTel añade un costo base fijo (providers, exporters y buffers de los procesadores por lotes) que se observa como un desplazamiento constante respecto a la línea base.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_name) (container_memory_usage_total_bytes{container_name=~\"service-.*|otel-collector\"})",
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*baseline.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Salud del OTel Collector",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Collector · Señales aceptadas por tipo",
      "description": "Volumen de las tres señales entrando al Collector. Si una de las tres cae a cero mientras las otras siguen, el problema está en el SDK de esa señal concreta, no en el Collector.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans{job=\"otel-collector-internal\"}[1m]))",
          "legendFormat": "Trazas (spans/s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points{job=\"otel-collector-internal\"}[1m]))",
          "legendFormat": "Métricas (puntos/s)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records{job=\"otel-collector-internal\"}[1m]))",
          "legendFormat": "Logs (registros/s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Collector · Errores — rechazos, descartes y envíos fallidos",
      "description": "Panel de errores del Collector. Cualquier serie por encima de cero significa PÉRDIDA de telemetría: rechazos indican contrapresión del memory_limiter; los envíos fallidos, un backend caído o inalcanzable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_refused_spans{job=\"otel-collector-internal\"}[1m])) or vector(0)",
          "legendFormat": "Spans rechazados"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_processor_dropped_spans{job=\"otel-collector-internal\"}[1m])) or vector(0)",
          "legendFormat": "Spans descartados"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans{job=\"otel-collector-internal\"}[1m])) or vector(0)",
          "legendFormat": "Envío de spans fallido"
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records{job=\"otel-collector-internal\"}[1m])) or vector(0)",
          "legendFormat": "Envío de logs fallido"
        },
        {
          "refId": "E",
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points{job=\"otel-collector-internal\"}[1m])) or vector(0)",
          "legendFormat": "Envío de métricas fallido"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Collector · Ocupación de la cola de exportación",
      "description": "Si la cola se acerca a su capacidad, el Collector no está drenando hacia los backends al ritmo que recibe y empezará a descartar telemetría.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exporter) (otelcol_exporter_queue_size{job=\"otel-collector-internal\"})",
          "legendFormat": "En cola · {{exporter}}"
        },
        {
          "refId": "B",
          "expr": "max(otelcol_exporter_queue_capacity{job=\"otel-collector-internal\"})",
          "legendFormat": "Capacidad"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capacidad"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs correlacionados — haz clic en un trace_id para saltar a la traza",
      "description": "Logs en vivo desde Loki. Cada línea lleva el trace_id del request que la produjo; los derivedFields del datasource lo convierten en un enlace directo a Jaeger. Este panel es el punto de partida de la correlación log → traza.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"service-.+\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Game Day · Logs de degradación (service-b inalcanzable)",
      "description": "Filtra los logs que emite service-a cuando su dependencia no responde. Durante el experimento de partición de red (E3) estas líneas son la prueba de que el fallback actuó: el servicio registró el fallo y degradó la respuesta en lugar de propagar un error 5xx al cliente. Fuera de un experimento este panel debe estar vacío.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"service-a\"} |= \"inalcanzable\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}